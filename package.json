{
  "name": "aspire-backend",
  "version": "1.0.0",
  "description": "Aspire - Selective Mock Exam | Backend REST API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "npx prisma generate && tsx watch src/server.ts",
    "build": "tsc --noEmit false",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "cross-env RUN_INTEGRATION_TESTS=true node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "fastify",
    "typescript",
    "prisma",
    "postgresql",
    "mock-exam"
  ],
  "author": "Aspire Team",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "resend": "^6.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "prisma": "^7.7.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3"
  }
}
