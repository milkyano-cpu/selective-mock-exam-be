# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
APP_NAME="Aspire Selective Entry Preparation"
API_PREFIX=/api/v1
APP_URL=http://localhost:3000

# ===========================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# ===========================================
# Pooler URL - for runtime queries (PrismaClient)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct URL - for Prisma Migrate (no pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST-direct/DATABASE?sslmode=require"

# ===========================================
# REDIS
# ===========================================
# When running via docker-compose, this is overridden to redis://redis:6379
# For local dev without Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ===========================================
# EMAIL (Resend)
# ===========================================
# Sign up at https://resend.com — free tier: 100 emails/day
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# For dev without a verified domain, use: onboarding@resend.dev
EMAIL_FROM="Aspire <onboarding@resend.dev>"
APP_LOGIN_URL=http://localhost:3000/login

# ===========================================
# OBJECT STORAGE (MINIO / S3)
# ===========================================
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=your-minio-access-key
S3_SECRET_KEY=your-minio-secret-key
S3_REGION=us-east-1
S3_PROFILE_PHOTO_BUCKET=aspire-profile-photos
S3_SIGNED_URL_EXPIRES_IN_SECONDS=3600
PROFILE_PHOTO_MAX_SIZE_BYTES=5242880

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000

ADMIN_EMAIL=admin@aspire.com
ADMIN_PASSWORD=SuperSecure!23
ADMIN_FULL_NAME=Platform Administrator

PASSWORD_RESET_EXPIRES_IN=1h
