NODE_ENV=production
PORT=3001
HOST=0.0.0.0
APP_NAME="Aspire Selective Entry Preparation"
API_PREFIX=/api/v1
APP_URL=https://api.example.com
DATABASE_URL="postgresql://USER:PASSWORD@PROD-HOST/aspire_prod?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@PROD-HOST-DIRECT/aspire_prod?sslmode=require"
REDIS_URL=redis://aspire-backend-redis:6379/2
JWT_SECRET=replace-with-prod-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
RESEND_API_KEY=re_prod_placeholder
EMAIL_FROM="Aspire <noreply@example.com>"
APP_LOGIN_URL=https://app.example.com/login
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=your-prod-access-key
S3_SECRET_KEY=your-prod-secret-key
S3_REGION=us-east-1
S3_PROFILE_PHOTO_BUCKET=aspire-profile-photos-prod
S3_SIGNED_URL_EXPIRES_IN_SECONDS=3600
PROFILE_PHOTO_MAX_SIZE_BYTES=5242880
CORS_ORIGIN=https://app.example.com
ADMIN_EMAIL=admin@aspire.com
ADMIN_PASSWORD=SuperSecure!23
ADMIN_FULL_NAME=Platform Administrator
PASSWORD_RESET_EXPIRES_IN=1h
