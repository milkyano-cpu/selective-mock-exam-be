generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// DOMAIN 1: USER MANAGEMENT
// ==========================================

enum Role {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum Gender {
  MALE
  FEMALE
}

enum Tier {
  BASIC
  STANDARD
  PREMIUM
}

enum AnnouncementPriority {
  NORMAL
  URGENT
}

enum AnnouncementStatus {
  SCHEDULED
  SENT
}

model User {
  id                       String     @id @default(uuid())
  email                    String     @unique // HMAC-SHA256 blind index of normalized email
  emailEncrypted           String     @map("email_encrypted") // AES-256-GCM encrypted actual email
  passwordHash             String     @map("password_hash")
  fullName                 String     @map("full_name") // AES-256-GCM encrypted
  fullNameTokens           String[]   @default([]) @map("full_name_tokens") // HMAC blind indexes per word
  role                     Role
  status                   UserStatus @default(ACTIVE)
  tier                     Tier       @default(BASIC)
  phoneNumber              String?    @map("phone_number") // AES-256-GCM encrypted if set
  address                  String? // AES-256-GCM encrypted if set
  gender                   Gender?
  yearLevel                String?    @map("year_level")
  schoolName               String?    @map("student_school_name")
  profilePhotoKey          String?    @map("profile_photo_key")
  profilePhotoOriginalName String?    @map("profile_photo_original_name")
  profilePhotoMimeType     String?    @map("profile_photo_mime_type")
  profilePhotoSize         Int?       @map("profile_photo_size")
  profilePhotoUpdatedAt    DateTime?  @map("profile_photo_updated_at")
  deletedAt                DateTime?  @map("deleted_at")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  // Relations
  children             ParentStudentRelation[]   @relation("ParentToStudent")
  parents              ParentStudentRelation[]   @relation("StudentToParent")
  questions            Question[]                @relation("TutorQuestions")
  examsCreated         Exam[]                    @relation("AdminExams")
  examSessions         ExamSession[]
  examAttemptSummaries ExamAttemptSummary[]
  practiceSessions     PracticeSession[]
  assignedPractices    PracticeSession[]         @relation("TutorAssigned")
  overriddenAnswers    StudentAnswer[]           @relation("AnswerOverrides")
  recommendations      Recommendation[]
  performance          StudentPerformance[]
  leaderboards         Leaderboard[]
  flashcards           Flashcard[]
  forumThreads         ForumThread[]             @relation("ForumThreadAuthor")
  forumPosts           ForumPost[]               @relation("ForumPostAuthor")
  forumFlagsReported   ForumFlag[]               @relation("ForumFlagReporter")
  forumFlagsReviewed   ForumFlag[]               @relation("ForumFlagReviewer")
  forumWarnings        ForumWarning[]            @relation("ForumWarningUser")
  forumWarningsGiven   ForumWarning[]            @relation("ForumWarningAdmin")
  subscriptions        Subscription[]
  billingInvoices      BillingInvoice[]
  pushSubscriptions    PushSubscription[]
  notifications        Notification[]
  announcements        Announcement[]            @relation("AuthorAnnouncements")
  calendarReminders    StudentCalendarReminder[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  studentPathways      StudentPathway[]          @relation("StudentPathways")
  tutorPathways        StudentPathway[]          @relation("TutorPathways")
  pathwayProgress      PathwayNodeProgress[]
  uploadedResources    Resource[]                @relation("uploadedResources")

  @@map("users")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Announcement {
  id          String               @id @default(uuid())
  authorId    String               @map("author_id")
  title       String
  message     String
  priority    AnnouncementPriority @default(NORMAL)
  target      String[]
  status      AnnouncementStatus   @default(SENT)
  scheduledAt DateTime?            @map("scheduled_at")
  sentAt      DateTime?            @map("sent_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  author User @relation("AuthorAnnouncements", fields: [authorId], references: [id])

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@map("announcements")
}

model ParentStudentRelation {
  parentId  String   @map("parent_id")
  studentId String   @map("student_id")
  createdAt DateTime @default(now()) @map("created_at")

  parent  User @relation("ParentToStudent", fields: [parentId], references: [id])
  student User @relation("StudentToParent", fields: [studentId], references: [id])

  @@id([parentId, studentId])
  @@index([studentId])
  @@map("parent_student_relations")
}

// ==========================================
// DOMAIN 2: MASTER DATA & QUESTION BANK
// ==========================================

model Subject {
  id           String   @id @default(uuid())
  name         String   @unique
  questionCode String?  @unique @map("question_code")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  topics      Topic[]
  questions   Question[]
  passages    Passage[]
  performance StudentPerformance[]
  pathways    StudentPathway[]

  @@map("subjects")
}

model Topic {
  id          String   @id @default(uuid())
  subjectId   String   @map("subject_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subject          Subject              @relation(fields: [subjectId], references: [id])
  questions        Question[]
  passages         Passage[]
  practiceSessions PracticeSession[]
  recommendations  Recommendation[]
  performance      StudentPerformance[]
  resources        StudyResource[]
  pathwayNodes     PathwayNode[]

  @@unique([subjectId, name])
  @@index([subjectId])
  @@map("topics")
}

enum PassageType {
  comprehension
  poem
  visual
}

enum PassageFormat {
  text
  poem
  article
  visual_text
  image_only
}

enum ImageDisplayPosition {
  above
  below
  inline
}

model Passage {
  id                   String                @id @default(uuid())
  passageId            String                @unique @map("passage_id")
  title                String?
  text                 String?
  passageFormat        PassageFormat         @map("passage_format")
  imageRef             String?               @map("image_ref")
  imageAltText         String?               @map("image_alt_text")
  imageCaption         String?               @map("image_caption")
  passageType          PassageType           @map("passage_type")
  imageDisplayPosition ImageDisplayPosition? @map("image_display_position")
  subjectId            String                @map("subject_id")
  topicId              String                @map("topic_id")
  difficulty           Difficulty
  latexEnabled         Boolean               @default(false) @map("latex_enabled")
  notes                String?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  subject   Subject    @relation(fields: [subjectId], references: [id])
  topic     Topic      @relation(fields: [topicId], references: [id])
  questions Question[]
  image     Image?     @relation("PassageImage", fields: [imageRef], references: [fileName], onDelete: SetNull, onUpdate: Cascade)

  @@index([imageRef])
  @@index([subjectId])
  @@index([topicId])
  @@map("passages")
}

enum QuestionType {
  MCQ
  ESSAY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
}

enum QuestionMarkingType {
  AUTO
  AI
  MANUAL
}

model AiRubric {
  id            String   @id
  name          String
  writingType   String?  @map("writing_type")
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  totalMaxScore Int      @map("total_max_score")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  criteria            AiRubricCriterion[]
  bandDescriptors     AiRubricBandDescriptor[]
  calibrationNotes    AiCalibrationNote[]
  questions           Question[]
  answerScores        EssayAnswerScore[]
  practiceEssayScores PracticeEssayScore[]

  @@index([isDefault, isActive])
  @@index([writingType])
  @@map("ai_rubrics")
}

model AiRubricCriterion {
  id                    String   @id @default(uuid())
  aiRubricId            String   @map("ai_rubric_id")
  criterionName         String   @map("criterion_name")
  criterionDescription  String   @map("criterion_description")
  maxScore              Int      @map("max_score")
  sortOrder             Int      @default(0) @map("sort_order")
  highScoringIndicators String[] @default([]) @map("high_scoring_indicators")
  lowScoringIndicators  String[] @default([]) @map("low_scoring_indicators")
  aiCalibrationNotes    String[] @default([]) @map("ai_calibration_notes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  aiRubric            AiRubric             @relation(fields: [aiRubricId], references: [id], onDelete: Cascade)
  answerScores        EssayAnswerScore[]
  practiceEssayScores PracticeEssayScore[]

  @@index([aiRubricId, sortOrder])
  @@map("ai_rubric_criteria")
}

model AiRubricBandDescriptor {
  id         String   @id @default(uuid())
  aiRubricId String   @map("ai_rubric_id")
  bandLabel  String   @map("band_label")
  scoreMin   Int      @map("score_min")
  scoreMax   Int      @map("score_max")
  descriptor String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  aiRubric AiRubric @relation(fields: [aiRubricId], references: [id], onDelete: Cascade)

  @@index([aiRubricId, scoreMin, scoreMax])
  @@map("ai_rubric_band_descriptors")
}

model AiCalibrationNote {
  id         String   @id @default(uuid())
  aiRubricId String   @map("ai_rubric_id")
  category   String?  @map("note_type")
  instruction String  @map("note")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  aiRubric AiRubric @relation(fields: [aiRubricId], references: [id], onDelete: Cascade)

  @@index([aiRubricId, sortOrder])
  @@map("ai_calibration_notes")
}

model AiRubricWritingType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_rubric_writing_types")
}

model Question {
  id               String              @id @default(uuid())
  questionId       String?             @map("question_id")
  questionNumber   Int?                @map("question_number")
  subjectId        String              @map("subject_id")
  topicId          String              @map("topic_id")
  tutorId          String              @map("tutor_id")
  passageId        String?             @map("passage_id")
  aiRubricId       String?             @map("ai_rubric_id")
  type             QuestionType
  difficulty       Difficulty
  questionText     String              @map("question_text")
  writingType      String?             @map("writing_type")
  promptText       String?             @map("prompt_text")
  markingGuide     String?             @map("marking_guide")
  options          Json?
  correctAnswer    String?             @map("correct_answer")
  explanation      String?
  timeLimitSeconds Int?                @map("time_limit_seconds")
  imageRefs        String[]            @default([]) @map("image_refs")
  subtopics        String[]            @default([])
  notes            String?
  latexEnabled     Boolean             @default(false) @map("latex_enabled")
  adaptiveTags     String[]            @default([]) @map("adaptive_tags")
  skillTags        String[]            @default([]) @map("skill_tags")
  markingType      QuestionMarkingType @default(AUTO) @map("marking_type")
  maxMarks         Int                 @default(1) @map("max_marks")
  isPracticeAllowed Boolean             @default(true) @map("is_practice_allowed")
  status           QuestionStatus      @default(DRAFT)
  rejectionNote    String?             @map("rejection_note")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  subject                  Subject                   @relation(fields: [subjectId], references: [id])
  topic                    Topic                     @relation(fields: [topicId], references: [id])
  tutor                    User                      @relation("TutorQuestions", fields: [tutorId], references: [id])
  passage                  Passage?                  @relation(fields: [passageId], references: [id])
  aiRubric                 AiRubric?                 @relation(fields: [aiRubricId], references: [id])
  examQuestions            ExamQuestion[]
  answers                  StudentAnswer[]
  practiceAnswers          PracticeAnswer[]
  practiceSessionQuestions PracticeSessionQuestion[]
  flashcards               Flashcard[]

  @@index([subjectId, topicId, status, difficulty])
  @@index([tutorId, status])
  @@index([passageId])
  @@index([aiRubricId])
  @@map("questions")
}

// ==========================================
// DOMAIN 3: FORMAL EXAMINATION (MOCK EXAM)
// ==========================================

enum ExamType {
  MOCK_EXAM
  ASSIGNMENT
}

enum GradingType {
  AUTO
  MANUAL
  MIXED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

model Exam {
  id              String      @id @default(uuid())
  title           String
  examType        ExamType    @map("exam_type")
  durationMinutes Int?        @map("duration_minutes")
  gradingType     GradingType @map("grading_type")
  status          ExamStatus  @default(DRAFT) @map("status")
  createdBy       String      @map("created_by")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  thresholdSuperior     Int @default(72) @map("threshold_superior")
  thresholdAboveAverage Int @default(60) @map("threshold_above_average")
  thresholdHighAverage  Int @default(50) @map("threshold_high_average")
  thresholdAverage      Int @default(40) @map("threshold_average")

  creator          User                 @relation("AdminExams", fields: [createdBy], references: [id])
  questions        ExamQuestion[]
  sessions         ExamSession[]
  attemptSummaries ExamAttemptSummary[]

  @@map("exams")
}

model ExamQuestion {
  examId     String @map("exam_id")
  questionId String @map("question_id")
  order      Int

  exam     Exam     @relation(fields: [examId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@id([examId, questionId])
  @@map("exam_questions")
}

enum SessionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum RetakeMode {
  FULL
  INCORRECT_ONLY
  SUBJECT_ONLY
}

enum RankingLevel {
  SUPERIOR
  ABOVE_AVERAGE
  HIGH_AVERAGE
  AVERAGE
  LOW_AVERAGE
}

model ExamSession {
  id                String        @id @default(uuid())
  examId            String        @map("exam_id")
  studentId         String        @map("student_id")
  status            SessionStatus @default(IN_PROGRESS)
  startTime         DateTime      @default(now()) @map("start_time")
  expiresAt         DateTime?     @map("expires_at")
  endTime           DateTime?     @map("end_time")
  totalTimeSeconds  Int?          @map("total_time_seconds")
  activeTimeSeconds Int           @default(0) @map("active_time_seconds")
  idleTimeSeconds   Int           @default(0) @map("idle_time_seconds")
  lastActivityAt    DateTime?     @map("last_activity_at")
  lastHeartbeatAt   DateTime?     @map("last_heartbeat_at")
  activeQuestionId  String?       @map("active_question_id")
  finalScore        Decimal?      @map("final_score") @db.Decimal(5, 2)
  mcqScore          Decimal?      @map("mcq_score") @db.Decimal(5, 2)
  essayScore        Decimal?      @map("essay_score") @db.Decimal(5, 2)
  rankingLevel      RankingLevel? @map("ranking_level")
  attemptNumber     Int           @default(1) @map("attempt_number")
  isFirstAttempt    Boolean       @default(false) @map("is_first_attempt")
  retakeMode        RetakeMode?   @map("retake_mode")
  parentSessionId   String?       @map("parent_session_id")
  retakeQuestionIds String[]      @default([]) @map("retake_question_ids")

  exam                 Exam                 @relation(fields: [examId], references: [id])
  student              User                 @relation(fields: [studentId], references: [id])
  answers              StudentAnswer[]
  attemptSummaryLatest ExamAttemptSummary[] @relation("LatestAttemptSummary")
  attemptSummaryBest   ExamAttemptSummary[] @relation("BestAttemptSummary")
  parentSession        ExamSession?         @relation("SessionRetakes", fields: [parentSessionId], references: [id])
  retakes              ExamSession[]        @relation("SessionRetakes")

  @@index([studentId, examId, status])
  @@index([examId, status])
  @@index([expiresAt])
  @@index([lastHeartbeatAt])
  @@map("exam_sessions")
}

model StudentAnswer {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  questionId       String   @map("question_id")
  studentAnswer    String   @map("student_answer")
  isCorrect        Boolean  @default(false) @map("is_correct")
  timeSpentSeconds Int      @map("time_spent_seconds")
  awardedMarks     Decimal? @map("awarded_marks") @db.Decimal(7, 2)
  manualScore      Decimal? @map("manual_score") @db.Decimal(5, 2)
  tutorFeedback    String?  @map("tutor_feedback")
  aiFeedback       Json?    @map("ai_feedback")
  bandLabel        String?  @map("band_label")
  bandDescriptor   String?  @map("band_descriptor")
  isOverridden     Boolean  @default(false) @map("is_overridden")
  overrideScore    Decimal? @map("override_score") @db.Decimal(7, 2)
  overrideNotes    String?  @map("override_notes")
  overriddenBy     String?  @map("overridden_by")
  aiModel          String?  @map("ai_model")

  session           ExamSession        @relation(fields: [sessionId], references: [id])
  question          Question           @relation(fields: [questionId], references: [id])
  overrideUser      User?              @relation("AnswerOverrides", fields: [overriddenBy], references: [id])
  essayAnswerScores EssayAnswerScore[]

  @@unique([sessionId, questionId])
  @@map("student_answers")
}

model EssayAnswerScore {
  id              String   @id @default(uuid())
  studentAnswerId String   @map("student_answer_id")
  aiRubricId      String?  @map("ai_rubric_id")
  criterionId     String?  @map("criterion_id")
  criterionName   String   @map("criterion_name")
  score           Decimal  @db.Decimal(7, 2)
  maxScore        Decimal  @map("max_score") @db.Decimal(7, 2)
  feedback        String?
  strengths       String[] @default([])
  improvements    String[] @default([])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  studentAnswer StudentAnswer      @relation(fields: [studentAnswerId], references: [id], onDelete: Cascade)
  aiRubric      AiRubric?          @relation(fields: [aiRubricId], references: [id], onDelete: SetNull)
  criterion     AiRubricCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)

  @@index([studentAnswerId])
  @@index([aiRubricId])
  @@index([criterionId])
  @@map("essay_answer_scores")
}

// ==========================================
// DOMAIN 4: PRACTICE & RECOMMENDATIONS
// ==========================================

enum PracticeSource {
  SELF_SELECTED
  TUTOR_ASSIGNED
  PATHWAY
  RECOMMENDATION
}

enum PracticeSessionStatus {
  IN_PROGRESS
  COMPLETED
}

model PracticeSession {
  id               String                @id @default(uuid())
  studentId        String                @map("student_id")
  topicId          String?               @map("topic_id")
  sourceType       PracticeSource        @map("source_type")
  assignedBy       String?               @map("assigned_by")
  pathwayNodeId    String?               @map("pathway_node_id")
  startedAt        DateTime              @default(now()) @map("started_at")
  endedAt          DateTime?             @map("ended_at")
  totalTimeSeconds Int?                  @map("total_time_seconds")
  status           PracticeSessionStatus @default(IN_PROGRESS) @map("status")
  difficulty       Difficulty?           @map("difficulty")
  questionCount    Int                   @default(10) @map("question_count")

  student          User                      @relation(fields: [studentId], references: [id])
  topic            Topic?                    @relation(fields: [topicId], references: [id])
  tutor            User?                     @relation("TutorAssigned", fields: [assignedBy], references: [id])
  pathwayNode      PathwayNode?              @relation(fields: [pathwayNodeId], references: [id])
  answers          PracticeAnswer[]
  sessionQuestions PracticeSessionQuestion[]

  @@index([studentId, topicId, sourceType])
  @@index([studentId, status])
  @@index([assignedBy])
  @@map("practice_sessions")
}

model PracticeAnswer {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  questionId       String   @map("question_id")
  studentAnswer    String   @map("student_answer")
  isCorrect        Boolean  @map("is_correct")
  timeSpentSeconds Int      @map("time_spent_seconds")
  awardedMarks     Decimal? @map("awarded_marks") @db.Decimal(7, 2)
  aiFeedback       Json?    @map("ai_feedback")
  bandLabel        String?  @map("band_label")
  bandDescriptor   String?  @map("band_descriptor")
  gradingStatus    String   @default("GRADED") @map("grading_status")
  aiModel          String?  @map("ai_model")

  session     PracticeSession      @relation(fields: [sessionId], references: [id])
  question    Question             @relation(fields: [questionId], references: [id])
  essayScores PracticeEssayScore[]

  @@index([sessionId, questionId])
  @@map("practice_answers")
}

model PracticeEssayScore {
  id               String   @id @default(uuid())
  practiceAnswerId String   @map("practice_answer_id")
  aiRubricId       String?  @map("ai_rubric_id")
  criterionId      String?  @map("criterion_id")
  criterionName    String   @map("criterion_name")
  score            Decimal  @db.Decimal(7, 2)
  maxScore         Decimal  @map("max_score") @db.Decimal(7, 2)
  feedback         String?
  strengths        String[] @default([])
  improvements     String[] @default([])
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  practiceAnswer PracticeAnswer     @relation(fields: [practiceAnswerId], references: [id], onDelete: Cascade)
  aiRubric       AiRubric?          @relation(fields: [aiRubricId], references: [id], onDelete: SetNull)
  criterion      AiRubricCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)

  @@index([practiceAnswerId])
  @@index([aiRubricId])
  @@index([criterionId])
  @@map("practice_essay_scores")
}

model PracticeSessionQuestion {
  id         String @id @default(uuid())
  sessionId  String @map("session_id")
  questionId String @map("question_id")
  order      Int

  session  PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@index([sessionId, order])
  @@map("practice_session_questions")
}

enum RecommendationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  IGNORED
}

model Recommendation {
  id            String               @id @default(uuid())
  studentId     String               @map("student_id")
  topicId       String               @map("topic_id")
  reason        String
  priorityScore Int                  @map("priority_score")
  status        RecommendationStatus @default(PENDING)
  createdAt     DateTime             @default(now()) @map("created_at")

  student User  @relation(fields: [studentId], references: [id])
  topic   Topic @relation(fields: [topicId], references: [id])

  @@index([studentId, status, priorityScore])
  @@index([topicId, status])
  @@map("recommendations")
}

// ==========================================
// DOMAIN 5: ANALYTICS & AGGREGATION
// ==========================================

model StudentPerformance {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  subjectId    String   @map("subject_id")
  topicId      String   @map("topic_id")
  scoreAvg     Float    @map("score_avg")
  attemptCount Int      @map("attempt_count")
  lastUpdated  DateTime @updatedAt @map("last_updated")

  student User    @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  topic   Topic   @relation(fields: [topicId], references: [id])

  @@unique([studentId, topicId])
  @@map("student_performances")
}

model ExamAttemptSummary {
  id                   String   @id @default(uuid())
  examId               String   @map("exam_id")
  studentId            String   @map("student_id")
  totalAttempts        Int      @default(0) @map("total_attempts")
  firstSessionId       String?  @map("first_session_id")
  latestSessionId      String?  @map("latest_session_id")
  bestSessionId        String?  @map("best_session_id")
  firstScore           Decimal? @map("first_score") @db.Decimal(5, 2)
  latestScore          Decimal? @map("latest_score") @db.Decimal(5, 2)
  bestScore            Decimal? @map("best_score") @db.Decimal(5, 2)
  incorrectQuestionIds String[] @default([]) @map("incorrect_question_ids")
  subjectBreakdown     Json?    @map("subject_breakdown")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  latestSession ExamSession? @relation("LatestAttemptSummary", fields: [latestSessionId], references: [id], onDelete: SetNull)
  bestSession   ExamSession? @relation("BestAttemptSummary", fields: [bestSessionId], references: [id], onDelete: SetNull)

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([examId])
  @@map("exam_attempt_summaries")
}

// ==========================================
// DOMAIN 5b: LEARNING PATHWAYS
// ==========================================

model StudentPathway {
  id               String   @id @default(uuid())
  studentId        String   @map("student_id")
  subjectId        String   @map("subject_id")
  tutorId          String   @map("tutor_id")
  thresholdCorrect Int      @default(3) @map("threshold_correct")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  student User          @relation("StudentPathways", fields: [studentId], references: [id])
  tutor   User          @relation("TutorPathways", fields: [tutorId], references: [id])
  subject Subject       @relation(fields: [subjectId], references: [id])
  nodes   PathwayNode[]

  @@unique([studentId, subjectId])
  @@index([studentId])
  @@index([tutorId])
  @@map("student_pathways")
}

model PathwayNode {
  id         String   @id @default(uuid())
  pathwayId  String   @map("pathway_id")
  topicId    String   @map("topic_id")
  orderIndex Int      @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pathway          StudentPathway        @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  topic            Topic                 @relation(fields: [topicId], references: [id])
  progress         PathwayNodeProgress[]
  practiceSessions PracticeSession[]

  @@unique([pathwayId, topicId])
  @@unique([pathwayId, orderIndex])
  @@index([pathwayId])
  @@map("pathway_nodes")
}

model PathwayNodeProgress {
  id             String    @id @default(uuid())
  nodeId         String    @map("node_id")
  studentId      String    @map("student_id")
  correctAnswers Int       @default(0) @map("correct_answers")
  totalAttempts  Int       @default(0) @map("total_attempts")
  isUnlocked     Boolean   @default(false) @map("is_unlocked")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  node    PathwayNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id])

  @@unique([nodeId, studentId])
  @@index([studentId])
  @@map("pathway_node_progress")
}

enum LeaderboardPeriod {
  WEEKLY
  MONTHLY
  ALL_TIME
}

model Leaderboard {
  id           String            @id @default(uuid())
  studentId    String            @map("student_id")
  rank         Int
  score        Float
  period       LeaderboardPeriod
  calculatedAt DateTime          @default(now()) @map("calculated_at")

  student User @relation(fields: [studentId], references: [id])

  @@index([period, rank])
  @@index([studentId, period])
  @@map("leaderboards")
}

// ==========================================
// DOMAIN 6: ACTIVE RECALL (FLASHCARDS)
// ==========================================

model Flashcard {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  questionId   String?  @map("question_id")
  frontContent String   @map("front_content")
  backContent  String   @map("back_content")
  createdAt    DateTime @default(now()) @map("created_at")

  student  User             @relation(fields: [studentId], references: [id])
  question Question?        @relation(fields: [questionId], references: [id])
  review   FlashcardReview?

  @@index([studentId, createdAt])
  @@map("flashcards")
}

model FlashcardReview {
  flashcardId    String   @id @map("flashcard_id")
  easeFactor     Decimal  @default(2.5) @map("ease_factor") @db.Decimal(5, 2)
  intervalDays   Int      @default(0) @map("interval_days")
  repetitions    Int      @default(0)
  nextReviewDate DateTime @map("next_review_date")

  flashcard Flashcard @relation(fields: [flashcardId], references: [id])

  @@index([nextReviewDate])
  @@map("flashcard_reviews")
}

// ==========================================
// DOMAIN 7: SYSTEM, SOCIAL & PAYMENTS
// ==========================================

enum ForumSegment {
  STUDENT
  PARENT
}

enum ForumStatus {
  ACTIVE
  FLAGGED
  UNDER_REVIEW
  REJECTED
}

enum FlagReason {
  INAPPROPRIATE
  SPAM
  OFF_TOPIC
  MISINFORMATION
  OTHER
}

enum FlagStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WarningLevel {
  WARNING
  SUSPEND
}

model ForumThread {
  id        String       @id @default(uuid())
  authorId  String       @map("author_id")
  segment   ForumSegment
  title     String
  isPinned  Boolean      @default(false) @map("is_pinned")
  isLocked  Boolean      @default(false) @map("is_locked")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  author User        @relation("ForumThreadAuthor", fields: [authorId], references: [id])
  posts  ForumPost[]

  @@index([segment, createdAt])
  @@index([isPinned, segment])
  @@map("forum_threads")
}

model ForumPost {
  id          String      @id @default(uuid())
  threadId    String      @map("thread_id")
  authorId    String      @map("author_id")
  isAnonymous Boolean     @default(false) @map("is_anonymous")
  content     String
  status      ForumStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User        @relation("ForumPostAuthor", fields: [authorId], references: [id])
  flags  ForumFlag[]

  @@index([threadId, status, createdAt])
  @@index([authorId])
  @@map("forum_posts")
}

model ForumFlag {
  id         String     @id @default(uuid())
  postId     String     @map("post_id")
  reporterId String     @map("reporter_id")
  reason     FlagReason
  note       String?
  status     FlagStatus @default(PENDING)
  reviewedBy String?    @map("reviewed_by")
  reviewedAt DateTime?  @map("reviewed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  post     ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User      @relation("ForumFlagReporter", fields: [reporterId], references: [id])
  reviewer User?     @relation("ForumFlagReviewer", fields: [reviewedBy], references: [id])

  @@unique([postId, reporterId])
  @@index([status, createdAt])
  @@map("forum_flags")
}

model ForumWarning {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  adminId   String       @map("admin_id")
  level     WarningLevel
  reason    String
  createdAt DateTime     @default(now()) @map("created_at")

  user  User @relation("ForumWarningUser", fields: [userId], references: [id])
  admin User @relation("ForumWarningAdmin", fields: [adminId], references: [id])

  @@index([userId, createdAt])
  @@map("forum_warnings")
}

model ForumBannedWord {
  id        String   @id @default(uuid())
  word      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("forum_banned_words")
}

enum ResourceType {
  FILE
  VIDEO
  PDF
  WORD
}

model StudyResource {
  id           String       @id @default(uuid())
  title        String
  resourceType ResourceType @map("resource_type")
  url          String
  topicId      String?      @map("topic_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  topic Topic? @relation(fields: [topicId], references: [id])

  @@map("study_resources")
}

model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}

model ExamCountdown {
  id        String   @id @default(uuid())
  title     String
  targetAt  DateTime @map("target_at")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, targetAt])
  @@index([targetAt])
  @@map("exam_countdowns")
}

model StudentCalendarReminder {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  reminderDate DateTime @map("reminder_date") @db.Date
  note         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, reminderDate])
  @@map("student_calendar_reminders")
}

model Banner {
  id        String   @id @default(uuid())
  imageUrl  String   @map("image_url")
  targetUrl String?  @map("target_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("banners")
}

enum ImageType {
  QUESTION
  PASSAGE
}

model Image {
  uuid        String    @id @default(uuid())
  fileName    String    @unique @map("file_name")
  imageType   ImageType @default(QUESTION) @map("image_type")
  refId       String?   @unique @map("ref_id")
  altText     String?   @map("alt_text")
  caption     String?
  url         String?
  expiredDate DateTime? @map("expired_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  passages  Passage[]  @relation("PassageImage")

  @@index([expiredDate])
  @@map("images")
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  stripeCustomerId     String   @map("stripe_customer_id")
  stripeSubscriptionId String   @map("stripe_subscription_id")
  stripePriceId        String?  @map("stripe_price_id")
  stripeProductId      String?  @map("stripe_product_id")
  tier                 Tier     @default(STANDARD)
  status               String
  cancelAtPeriodEnd    Boolean  @default(false) @map("cancel_at_period_end")
  currentPeriodEnd     DateTime @map("current_period_end")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([stripeSubscriptionId])
  @@index([userId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

model BillingInvoice {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  stripeInvoiceId      String    @map("stripe_invoice_id")
  stripeCustomerId     String    @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  invoiceNumber        String?   @map("invoice_number")
  status               String
  currency             String
  amountDue            Int       @default(0) @map("amount_due")
  amountPaid           Int       @default(0) @map("amount_paid")
  hostedInvoiceUrl     String?   @map("hosted_invoice_url")
  stripeInvoicePdfUrl  String?   @map("stripe_invoice_pdf_url")
  minioObjectKey       String?   @map("minio_object_key")
  periodStart          DateTime? @map("period_start")
  periodEnd            DateTime? @map("period_end")
  paidAt               DateTime? @map("paid_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stripeInvoiceId])
  @@index([userId, createdAt])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@map("billing_invoices")
}

// ==========================================
// AUTH: TOKEN MANAGEMENT
// ==========================================

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  jti       String
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@index([jti, userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Resource {
  id           String       @id @default(uuid())
  title        String
  description  String       @default("")
  type         ResourceType
  fileUrl      String?      @map("file_url")
  videoUrl     String?      @map("video_url")
  fileName     String?      @map("file_name")
  fileSize     Int?         @map("file_size")
  mimeType     String?      @map("mime_type")
  allowedTiers Tier[]       @default([BASIC, STANDARD, PREMIUM]) @map("allowed_tiers")
  uploadedBy   String       @map("uploaded_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  uploader User @relation("uploadedResources", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([uploadedBy])
  @@index([type])
  @@index([allowedTiers], type: Gin)
  @@map("resources")
}
